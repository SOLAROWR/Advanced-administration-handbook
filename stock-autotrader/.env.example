# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요.
# .env 파일은 비밀번호와 같습니다. 절대 다른 사람에게 보여주거나 GitHub에 올리지 마세요.

# 한국투자증권 KIS Developers 에서 발급받은 앱키/시크릿
KIS_APP_KEY=여기에_앱키
KIS_APP_SECRET=여기에_앱시크릿
# 계좌번호 (앞 8자리-뒤 2자리)
KIS_ACCOUNT_NO=12345678-01

# (선택) 텔레그램 알림
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 실전(real) 모드로 돌릴 때만 YES 로 바꾸세요. (안전장치)
I_UNDERSTAND_REAL_MONEY=NO
